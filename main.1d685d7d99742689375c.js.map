module.exports = "#version 300 es\nprecision highp float;\nprecision highp int;\nprecision highp sampler2D;\n#define GLSLIFY 1\n\nuniform sampler2D traceTexture;\n\nout vec4 fragColor;\nin vec2 uv;\n\nvoid main() {\n    vec3 accumSamples = texture(traceTexture, uv).rgb;\n    fragColor = vec4(accumSamples, 1.);\n}\n"